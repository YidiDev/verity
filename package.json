{
  "name": "verity-dl",
  "version": "2.0.1",
  "description": "A framework agnostic data layer built to handle the communication layer between the server and the client seamlessly and keep the ui state always up to date with the source of truth",
  "type": "module",
  "main": "./dist/core.cjs",
  "module": "./dist/core.mjs",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./adapters/alpine": {
      "import": {
        "types": "./dist/adapters/alpine.d.ts",
        "default": "./dist/adapters/alpine.mjs"
      },
      "require": {
        "types": "./dist/adapters/alpine.d.cts",
        "default": "./dist/adapters/alpine.cjs"
      }
    },
    "./adapters/react": {
      "import": {
        "types": "./dist/adapters/react.d.ts",
        "default": "./dist/adapters/react.mjs"
      },
      "require": {
        "types": "./dist/adapters/react.d.cts",
        "default": "./dist/adapters/react.cjs"
      }
    },
    "./adapters/vue": {
      "import": {
        "types": "./dist/adapters/vue.d.ts",
        "default": "./dist/adapters/vue.mjs"
      },
      "require": {
        "types": "./dist/adapters/vue.d.cts",
        "default": "./dist/adapters/vue.cjs"
      }
    },
    "./adapters/svelte": {
      "import": {
        "types": "./dist/adapters/svelte.d.ts",
        "default": "./dist/adapters/svelte.mjs"
      },
      "require": {
        "types": "./dist/adapters/svelte.d.cts",
        "default": "./dist/adapters/svelte.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools/index.d.ts",
        "default": "./dist/devtools/devtools.mjs"
      },
      "require": {
        "types": "./dist/devtools/index.d.cts",
        "default": "./dist/devtools/devtools.cjs"
      }
    },
    "./devtools/style.css": "./dist/devtools/devtools.css"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "yarn build && vitest run",
    "test:coverage": "yarn build && vitest run --coverage",
    "test:watch": "yarn build && vitest",
    "check": "yarn typecheck && yarn lint && yarn build && vitest run"
  },
  "keywords": [
    "ui",
    "toolkit",
    "data-first",
    "server-sent-events",
    "alpine",
    "react",
    "vue",
    "svelte"
  ],
  "author": "YidiDev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YidiDev/verity.git"
  },
  "homepage": "https://verity.yidi.sh",
  "funding": {
    "url": "https://github.com/sponsors/YidiDev"
  },
  "bugs": {
    "url": "https://github.com/YidiDev/verity/issues"
  },
  "packageManager": "yarn@4.15.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.11"
  }
}
